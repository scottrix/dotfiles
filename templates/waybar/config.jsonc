// tint2 replacement: bottom panel, taskbar left, tray/volume/battery/clock right
{
    "layer": "top",
    "position": "bottom",
    "height": 27,
    "spacing": 6,
    "modules-left": ["wlr/taskbar"],
    "modules-center": [],
    "modules-right": ["tray", "network#eth", "network#wifi", "pulseaudio", "battery", "clock"],

    "wlr/taskbar": {
        "format": "{icon} {title:.20}",
        "icon-size": 16,
        "tooltip-format": "{title}",
        "on-click": "activate",
        "on-click-middle": "close",
        "on-click-right": "minimize"
    },
    "tray": {
        "icon-size": 16,
        "spacing": 6
    },
    "network#eth": {
        "interface": "${ETH_IF}",
        "interval": 5,
        "format-ethernet": "󰈀",
        "format-wifi": "",
        "format-linked": "󰈀",
        "format-disconnected": "",
        "tooltip-format": "{ifname} {ipaddr}/{cidr} via {gwaddr}",
        "on-click": "foot --app-id=impala -e impala"
    },
    "network#wifi": {
        "interface": "wlan0",
        "interval": 5,
        "format-wifi": "{icon}",
        "format-icons": ["󰤟", "󰤢", "󰤥", "󰤨"],
        "format-ethernet": "",
        "format-linked": "󰤫",
        "format-disconnected": "󰤮",
        "tooltip-format": "{ifname} {essid} {signalStrength}% {ipaddr}/{cidr} via {gwaddr}",
        "tooltip-format-disconnected": "wifi off",
        "on-click": "foot --app-id=impala -e impala"
    },
    "pulseaudio": {
        "format": "{icon}",
        "format-muted": "󰝟",
        "format-icons": { "default": ["󰕿", "󰖀", "󰕾"] },
        "tooltip-format": "{volume}% {desc}",
        "scroll-step": 2,
        "on-click": "pavucontrol",
        "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"
    },
    "battery": {
        "format": "{icon}",
        "format-charging": "{icon}",
        "format-plugged": "{icon}",
        "format-icons": {
            "default": ["󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
            "charging": ["󰢜", "󰂆", "󰂇", "󰂈", "󰢝", "󰂉", "󰢞", "󰂊", "󰂋", "󰂅"],
            "plugged": ["󰢜", "󰂆", "󰂇", "󰂈", "󰢝", "󰂉", "󰢞", "󰂊", "󰂋", "󰂅"]
        },
        "tooltip-format": "{capacity}% ({time} left)",
        "states": { "warning": 20, "critical": 10 }
    },
    "clock": {
        "interval": 1,
        "format": "{:%a %d %b %H:%M:%S}",
        "tooltip-format": "<tt>{calendar}</tt>"
    }
}
