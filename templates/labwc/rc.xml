<?xml version="1.0"?>
<!-- labwc config ported from Scott's openbox rc.xml; generated by dotfiles steps/50-desktop.sh -->
<labwc_config>

  <core>
    <gap>0</gap>
  </core>

  <theme>
    <name>Clearlooks-3.4</name>
    <cornerRadius>0</cornerRadius>
    <titlebar>
      <layout>icon:iconify,max,close</layout>
    </titlebar>
    <font place="ActiveWindow"><name>sans</name><size>8</size></font>
    <font place="InactiveWindow"><name>sans</name><size>8</size></font>
    <font place="MenuHeader"><name>sans</name><size>9</size></font>
    <font place="MenuItem"><name>sans</name><size>8</size></font>
    <font place="OnScreenDisplay"><name>sans</name><size>8</size></font>
  </theme>

  <focus>
    <followMouse>yes</followMouse>
    <followMouseRequiresMovement>yes</followMouseRequiresMovement>
    <raiseOnFocus>no</raiseOnFocus>
  </focus>

  <placement>
    <policy>cursor</policy>
  </placement>

  <desktops>
    <popupTime>875</popupTime>
    <initial>Main</initial>
    <names>
      <name>Main</name>
      <name>Web</name>
      <name>Mail</name>
    </names>
  </desktops>

  <keyboard>
    <keybind key="W-F1">
      <action name="ToggleMaximize"/>
      <action name="Raise"/>
    </keybind>
    <keybind key="W-F2">
      <action name="Execute" command="~/bin/lock"/>
    </keybind>

    <keybind key="W-1"><action name="GoToDesktop" to="1"/></keybind>
    <keybind key="W-2"><action name="GoToDesktop" to="2"/></keybind>
    <keybind key="W-3"><action name="GoToDesktop" to="3"/></keybind>

    <keybind key="W-Tab"><action name="NextWindow"/></keybind>
    <keybind key="W-S-Tab"><action name="PreviousWindow"/></keybind>
    <keybind key="W-space"><action name="ShowMenu" menu="root-menu"/></keybind>

    <keybind key="XF86AudioMute">
      <action name="Execute" command="wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"/>
    </keybind>
    <keybind key="XF86AudioLowerVolume">
      <action name="Execute" command="wpctl set-volume @DEFAULT_AUDIO_SINK@ 2%- --limit 1.0"/>
    </keybind>
    <keybind key="XF86AudioRaiseVolume">
      <action name="Execute" command="wpctl set-volume @DEFAULT_AUDIO_SINK@ 2%+ --limit 1.0"/>
    </keybind>
    <keybind key="XF86MonBrightnessUp">
      <action name="Execute" command="brightnessctl set 5%+"/>
    </keybind>
    <keybind key="XF86MonBrightnessDown">
      <action name="Execute" command="brightnessctl set 5%-"/>
    </keybind>
    <keybind key="Print">
      <action name="Execute" command="sh -c 'grim -g &quot;$(slurp)&quot; ~/Pictures/$(date +%F-%H%M%S).png'"/>
    </keybind>
  </keyboard>

  <mouse>
    <default/>
  </mouse>

  <!-- touchpad: press with 1/2/3 fingers for left/right/middle; tapping does nothing -->
  <libinput>
    <device category="touchpad">
      <tap>no</tap>
      <clickMethod>clickfinger</clickMethod>
    </device>
  </libinput>

  <!-- login layout: 3x3 terminal grid on Main, browser on Web, mail on Mail -->
  <windowRules>
${TERM_RULES}
${APP_RULES}
  </windowRules>

</labwc_config>
