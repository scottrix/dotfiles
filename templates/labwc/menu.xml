<?xml version="1.0" encoding="UTF-8"?>
<openbox_menu>
	<menu id="root-menu" label="labwc">
		<item label="${BROWSER_LABEL}"> <action name="Execute">
			<execute>${BROWSER_CMD}</execute>
		</action> </item>
		<item label="Terminal"> <action name="Execute">
			<execute>foot</execute>
		</action> </item>
		<item label="Files"> <action name="Execute">
			<execute>thunar</execute>
		</action> </item>
${MAIL_MENU_ITEM}
		<menu id="20" label="Settings">
			<item label="Volume"> <action name="Execute">
				<execute>pavucontrol</execute>
			</action> </item>
			<item label="Bluetooth"> <action name="Execute">
				<execute>blueman-manager</execute>
			</action> </item>
			<item label="Wi-Fi"> <action name="Execute">
				<execute>foot --app-id=impala -e impala</execute>
			</action> </item>
		</menu>
		<separator/>
		<menu id="40" label="labwc">
			<menu id="client-list-combined-menu"/>
			<item label="Reconfigure"> <action name="Reconfigure"/> </item>
			<separator/>
			<item label="Exit"> <action name="Exit"/> </item>
		</menu>
		<item label="Lock"> <action name="Execute">
			<execute>~/bin/lock</execute>
		</action> </item>
		<item label="Suspend"> <action name="Execute">
			<execute>loginctl suspend</execute>
		</action> </item>
		<item label="Reboot"> <action name="Execute">
			<execute>loginctl reboot</execute>
		</action> </item>
		<item label="Shutdown"> <action name="Execute">
			<execute>loginctl poweroff</execute>
		</action> </item>
	</menu>
</openbox_menu>
