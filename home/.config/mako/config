# Notifications styled like waybar: dark grey box, white text, the desktop's #006688 blue
font=sans 10
background-color=#222222
text-color=#ffffff
border-color=#006688
border-size=2
border-radius=0
padding=8
margin=10
width=350
icons=1
max-icon-size=32
default-timeout=5000

[urgency=low]
border-color=#555555

[urgency=critical]
border-color=#ff4444
default-timeout=0
