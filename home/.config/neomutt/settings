# settings
set pager_index_lines = 10          
set pager_context = 3                # show 3 lines of context
set pager_stop                       # stop at end of message
set menu_scroll                      # scroll menu
set tilde                            # use ~ to pad mutt
set move=no                          # don't move messages when marking as read
set mail_check = 30                  # check for new mail every 30 seconds
set imap_keepalive = 180             # 3 minutes
set sleep_time = 0                   # don't sleep when idle
set wait_key = no		     # mutt won't ask "press key to continue"
set envelope_from                    # which from?
set edit_headers                     # show headers when composing
set fast_reply                       # skip to compose when replying
set fcc_attach                       # save attachments with the body
set forward_format = "Fwd: %s"       # format of subject when forwarding
set forward_decode                   # decode when forwarding
set forward_quote                    # include message in forwards
set mime_forward = ask-yes
set mime_forward_rest = ask-yes
set attribution = "On %d, %n wrote:" # format of quoting header
set reply_to                         # reply to Reply to: field
set reverse_name                     # reply as whomever it was to
set reverse_alias
set include                          # include message in replies
set text_flowed=yes                  # correct indentation for plain text
unset sig_dashes                     # no dashes before sig
unset markers

# Sort by newest conversation first.
set charset = "utf-8"
set send_charset = "utf-8:iso-8859-1:us-ascii" # send in utf-8
set assumed_charset="utf-8:iso-8859-15:iso-8859-1"
set config_charset="utf-8"

set uncollapse_jump
set sort_re
set sort = date
set sort_aux = last-date-received
# How we reply and quote emails.
set reply_regexp = "^(([Rr][Ee]?(\[[0-9]+\])?: *)?(\[[^]]+\] *)?)*"
set quote_regexp = "^( {0,4}[>|:#%]| {0,4}[a-z0-9]+[>|]+)+"

set editor="vim -c 'set fo+=aw' -c 'set textwidth=75'"

set imap_check_subscribed="yes"
set imap_list_subscribed="yes"
set timeout=15
set imap_idle

set dsn_notify="failure,delay"
set dsn_return=hdrs

# Set up printing
set print="yes"
set print_split
set print_command="enscript --portrait --header='%n@%M:%d|%F %C|Page ($%/$=)' --media=A4 --silent --pretty-print=mail"
set print_decode

# Setup some global options.

set quit=ask-yes
set ispell="clear; aspell --mode=email check"
set tmpdir="/tmp"
set ascii_chars
set crypt_use_gpgme=yes

set mailcap_path        = "$XDG_CONFIG_HOME/neomutt/mailcap"
auto_view text/html
alternative_order text/plain text/html

# What to display
ignore *
unignore To: From: Date: Subject: CC:
hdr_order From: Date: To: CC: Subject:
set index_format="%4C %Z %{%b %d} %-15.15L %s"
