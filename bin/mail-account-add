#!/usr/bin/env bash
# Add an IMAP/SMTP account to neomutt. Passwords are stored GPG-encrypted and
# decrypted by neomutt when it starts (gpg-agent caches the key's passphrase).
# The account added last is the one neomutt opens at startup; F2, F3, ...
# switch between accounts in the order they were added.
# shellcheck disable=SC2154  # prompt/secret assign their variables through printf -v
set -euo pipefail

# the same directory neomuttrc and accounts.rc name as ~/.config/neomutt
dir=$HOME/.config/neomutt
die() { printf 'mail-account-add: %s\n' "$*" >&2; exit 1; }

# prompt VAR QUESTION [DEFAULT]
prompt() {
    local answer
    IFS= read -r -p "$2${3:+ [$3]}: " answer || true
    printf -v "$1" '%s' "${answer:-${3:-}}"
    [ -n "${!1}" ] || die "$2 is required"
}
# secret VAR QUESTION [DEFAULT]  like prompt, without echo; keeps surrounding spaces
secret() {
    local answer
    IFS= read -rs -p "$2: " answer || true
    echo
    printf -v "$1" '%s' "${answer:-${3:-}}"
    [ -n "${!1}" ] || die "$2 is required"
}
# esc TEXT  escape TEXT for use inside a double-quoted neomutt string
esc() {
    local t=${1//\\/\\\\}
    t=${t//\"/\\\"}
    t=${t//\$/\\\$}
    t=${t//\`/\\\`}
    printf '%s' "$t"
}
# shq TEXT  single-quote TEXT for a shell command
shq() { printf "'%s'" "${1//\'/\'\\\'\'}"; }
valid_host() { [[ $1 =~ ^[A-Za-z0-9.-]+$ ]]; }
valid_port() { [[ $1 =~ ^[0-9]+$ ]] && [ "$1" -ge 1 ] && [ "$1" -le 65535 ]; }

# usable_fpr: fingerprint of the first secret key that is neither expired,
# revoked nor disabled and can encrypt
usable_fpr() {
    gpg --list-secret-keys --with-colons 2> /dev/null | awk -F: '
        $1 == "sec" { ok = ($2 !~ /^[erd]/ && $12 ~ /[eE]/) }
        $1 == "fpr" && ok { print $10; exit }'
}

[ -f "$dir/accounts.rc" ] || die "no $dir/accounts.rc; run the dotfiles installer with neomutt first"

recipient=$(usable_fpr)
if [ -z "$recipient" ]; then
    echo "No usable GPG key found. One is needed to encrypt mail passwords."
    prompt create "Create one now? (y/n)" y
    [[ $create == [Yy]* ]] || exit 1
    prompt keyname "Name for the key" "$(getent passwd "$USER" | cut -d: -f5 | cut -d, -f1)"
    [[ $keyname != *[\<\>]* ]] || die "key name must not contain < or >"
    prompt keymail "Email for the key"
    [[ $keymail =~ ^[^[:space:]@\<\>]+@[^[:space:]@\<\>]+$ ]] || die "not an email address: $keymail"
    gpg --quick-generate-key "$keyname <$keymail>" default default never
    recipient=$(usable_fpr)
    [ -n "$recipient" ] || die "no usable GPG key after creating one"
fi

prompt name "Short account name (letters, digits, - or _)"
[[ $name =~ ^[A-Za-z0-9_-]+$ ]] || die "bad account name: $name"
[ ! -e "$dir/account.$name" ] || die "account $name already exists: $dir/account.$name"
prompt from "From address"
prompt realname "Your name" "$(getent passwd "$USER" | cut -d: -f5 | cut -d, -f1)"
prompt imap_host "IMAP server"
valid_host "$imap_host" || die "bad IMAP server name: $imap_host"
prompt imap_port "IMAP port" 993
valid_port "$imap_port" || die "bad IMAP port: $imap_port"
prompt imap_user "IMAP user" "$from"
prompt smtp_host "SMTP server"
valid_host "$smtp_host" || die "bad SMTP server name: $smtp_host"
prompt smtp_port "SMTP port (465 = TLS, 587 = STARTTLS)" 465
valid_port "$smtp_port" || die "bad SMTP port: $smtp_port"
prompt smtp_user "SMTP user" "$imap_user"
secret imap_pass "IMAP password"
secret smtp_pass "SMTP password (Enter = same as IMAP)" "$imap_pass"

smtp_scheme=smtps
[ "$smtp_port" = 465 ] || smtp_scheme=smtp

umask 077
printf '%s' "$imap_pass" | gpg --batch --yes --quiet -e -r "$recipient" -o "$dir/pass.$name.imap.gpg"
printf '%s' "$smtp_pass" | gpg --batch --yes --quiet -e -r "$recipient" -o "$dir/pass.$name.smtp.gpg"

q_from=$(esc "$from") q_realname=$(esc "$realname")
q_imap_user=$(esc "$imap_user") q_smtp_user=$(esc "$smtp_user")
q_imap_cmd=$(esc "gpg --batch -dq $(shq "$dir/pass.$name.imap.gpg")")
q_smtp_cmd=$(esc "gpg --batch -dq $(shq "$dir/pass.$name.smtp.gpg")")

cat > "$dir/account.$name" << EOT
# $name: written by mail-account-add
set from = "$q_from"
set realname = "$q_realname"

set imap_user = "$q_imap_user"
set imap_pass = "\`$q_imap_cmd\`"
set folder = "imaps://$imap_host:$imap_port/"

set smtp_user = "$q_smtp_user"
set smtp_pass = "\`$q_smtp_cmd\`"
set smtp_url = "$smtp_scheme://$smtp_host:$smtp_port/"

set ssl_starttls = yes
set ssl_force_tls = yes

set spoolfile = "+Inbox"
set postponed = "+Drafts"
set record = "+Sent"
set trash = "+Trash"

set header_cache = "~/.cache/neomutt/headers.$name"
set message_cachedir = "~/.cache/neomutt/bodies.$name"
set certificate_file = "~/.cache/neomutt/certificates.$name"
EOT

macro_written=
key=$(($(grep -c '^macro index <f' "$dir/accounts.rc" || true) + 2))
{
    # shellcheck disable=SC2016
    printf '\nsource "~/.config/neomutt/account.%s"\n' "$name"
    printf "folder-hook \$folder 'source \"~/.config/neomutt/account.%s\"'\n" "$name"
    if [ "$key" -le 12 ]; then
        macro_written=1
        printf "macro index <f%s> '<sync-mailbox><enter-command>source \"~/.config/neomutt/account.%s\"<enter><change-folder>!<enter>'\n" "$key" "$name"
    fi
} >> "$dir/accounts.rc"

msg="Added $name. Start neomutt to check it"
[ -z "$macro_written" ] || msg="$msg; F$key switches to it"
echo "$msg."
